# syntax=docker/dockerfile:1

# ---- Sphere image ----
FROM golang:1.27-alpine AS sphere-build
ARG VERSION=dev
ARG GIT_COMMIT=unknown
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -ldflags "-X main.version=${VERSION} -X main.gitCommit=${GIT_COMMIT}" -o /out/sphere ./cmd/sphere

FROM alpine:3.21 AS sphere
RUN apk add --no-cache ca-certificates tzdata
WORKDIR /app
COPY --from=sphere-build /out/sphere /app/sphere
COPY config/sphere.example.toml /app/config.example.toml
EXPOSE 5071 7099
ENTRYPOINT ["/app/sphere"]
