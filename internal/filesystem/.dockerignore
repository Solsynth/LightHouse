# VCS/editor noise
.git
.gitignore
.github
.idea
.vscode

# Go build output and local config
bin
config.toml
*.test

# SPA dependencies and build output (rebuilt inside the image)
web/node_modules
web/dist
web/coverage
web/.eslintcache
web/.vite
web/node_modules/.tmp

# Local tooling
memo
scripts
# docs/ is a Go package: docs.go registers the swagger spec and server
# imports it, so the directory has to stay in the build context. Only its
# Markdown is dropped.
*.md
docs/*.md
docker-compose*.yml
LICENSE.txt
